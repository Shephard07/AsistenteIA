@model Asistente.Web.Models.AdministracionViewModel

@{
    ViewData["Title"] = "Gestor documental";
    var puedeAdministrar = User.IsInRole("Administrador");
}

<div id="documentosPage"
     data-api-base-url="@Model.ApiBaseUrl"
     data-puede-administrar="@puedeAdministrar.ToString().ToLowerInvariant()">

    <div class="d-flex justify-content-between align-items-start mb-4">
        <div>
            <h1 class="h3 mb-1">Gestor documental</h1>
            <p class="text-muted mb-0">
                Registra, clasifica, versiona y consulta documentos PDF empresariales.
            </p>
        </div>

        @if (puedeAdministrar)
        {
            <button id="btnNuevoDocumento"
                    type="button"
                    class="btn btn-primary">
                Nuevo documento
            </button>
        }
    </div>

    <div id="mensajeDocumentos"
         class="alert d-none"
         role="alert"></div>

    <section class="card shadow-sm mb-4">
        <div class="card-body">
            <h2 class="h5 mb-3">Filtros de búsqueda</h2>

            <form id="formFiltrosDocumentos" class="row g-3">
                <div class="col-md-4">
                    <label for="terminoBusquedaDocumento"
                           class="form-label">
                        Código o nombre
                    </label>

                    <input id="terminoBusquedaDocumento"
                           class="form-control"
                           placeholder="Buscar documento..." />
                </div>

                <div class="col-md-3">
                    <label for="filtroCategoriaDocumento"
                           class="form-label">
                        Categoría
                    </label>

                    <select id="filtroCategoriaDocumento"
                            class="form-select">
                        <option value="">Todas las categorías</option>
                    </select>
                </div>

                <div class="col-md-2">
                    <label for="filtroEstadoDocumento"
                           class="form-label">
                        Estado
                    </label>

                    <select id="filtroEstadoDocumento"
                            class="form-select">
                        <option value="">Todos</option>
                        <option value="Borrador">Borrador</option>
                        <option value="Activo">Activo</option>
                        <option value="Archivado">Archivado</option>
                        <option value="Eliminado">Eliminado</option>
                    </select>
                </div>

                <div class="col-md-3">
                    <label for="fechaDesdeDocumento"
                           class="form-label">
                        Desde
                    </label>

                    <input id="fechaDesdeDocumento"
                           class="form-control"
                           type="date" />
                </div>

                <div class="col-md-3">
                    <label for="fechaHastaDocumento"
                           class="form-label">
                        Hasta
                    </label>

                    <input id="fechaHastaDocumento"
                           class="form-control"
                           type="date" />
                </div>

                <div class="col-12 d-flex justify-content-end gap-2">
                    <button id="btnLimpiarFiltrosDocumentos"
                            type="button"
                            class="btn btn-outline-secondary">
                        Limpiar
                    </button>

                    <button type="submit"
                            class="btn btn-outline-primary">
                        Buscar
                    </button>
                </div>
            </form>
        </div>
    </section>

    @if (puedeAdministrar)
    {
        <section id="panelFormularioDocumento"
                 class="card shadow-sm mb-4 d-none">
            <div class="card-body">
                <h2 id="tituloFormularioDocumento" class="h5 mb-3">
                    Nuevo documento
                </h2>

                <form id="formDocumento" class="row g-3">
                    <input id="idDocumentoEdicion" type="hidden" />

                    <div class="col-md-4">
                        <label for="codigoDocumento"
                               class="form-label">
                            Código
                        </label>

                        <input id="codigoDocumento"
                               class="form-control"
                               maxlength="50"
                               placeholder="Ejemplo: PROC-CAL-001"
                               required />
                    </div>

                    <div class="col-md-8">
                        <label for="nombreDocumento"
                               class="form-label">
                            Nombre
                        </label>

                        <input id="nombreDocumento"
                               class="form-control"
                               maxlength="250"
                               required />
                    </div>

                    <div class="col-md-6">
                        <label for="categoriaDocumento"
                               class="form-label">
                            Categoría
                        </label>

                        <select id="categoriaDocumento"
                                class="form-select"
                                required>
                            <option value="">Selecciona una categoría</option>
                                               </select>
                    </div>

                    <div class="col-md-6">
                        <label for="archivoDocumento"
                               class="form-label">
                            Archivo PDF inicial
                        </label>

                        <input id="archivoDocumento"
                               class="form-control"
                               type="file"
                               accept=".pdf,application/pdf"
                               required />

                        <div class="form-text">
                            Máximo 10 MB. En edición, usa “Nueva versión”
                            para reemplazar el PDF.
                        </div>
                    </div>

                    <div class="col-12">
                        <label for="descripcionDocumento"
                               class="form-label">
                            Descripción
                        </label>

                        <textarea id="descripcionDocumento"
                                  class="form-control"
                                  rows="3"
                                  maxlength="1000"></textarea>
                    </div>

                    <div class="col-12 d-flex justify-content-end gap-2">
                        <button id="btnCancelarDocumento"
                                type="button"
                                class="btn btn-outline-secondary">
                            Cancelar
                        </button>

                        <button id="btnGuardarDocumento"
                                type="submit"
                                class="btn btn-primary">
                            Registrar documento
                        </button>
                    </div>
                </form>
            </div>
        </section>
    }

    <section class="card shadow-sm mb-4">
        <div class="card-body">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <h2 class="h5 mb-0">Documentos registrados</h2>

                <button id="btnActualizarDocumentos"
                        type="button"
                        class="btn btn-outline-primary btn-sm">
                    Actualizar
                </button>
            </div>

            <div class="table-responsive">
                <table class="table align-middle mb-0">
                    <thead>
                        <tr>
                            <th>Código</th>
                            <th>Documento</th>
                            <th>Categoría</th>
                            <th>Versión</th>
                            <th>Estado</th>
                            <th>Procesamiento</th>
                            <th>Registro</th>
                            <th class="text-end">Acciones</th>
                        </tr>
                    </thead>

                    <tbody id="documentosBody"></tbody>
                </table>
            </div>
        </div>
    </section>

    <section id="panelDetalleDocumento"
             class="card shadow-sm d-none">
        <div class="card-body">
            <div class="d-flex justify-content-between align-items-start mb-4">
                <div>
                    <p id="codigoDetalleDocumento"
                       class="small text-primary fw-semibold mb-1"></p>

                    <h2 id="nombreDetalleDocumento" class="h4 mb-1"></h2>

                    <p id="metadatosDetalleDocumento"
                       class="text-muted mb-0"></p>
                </div>

                <button id="btnCerrarDetalleDocumento"
                        type="button"
                        class="btn btn-outline-secondary btn-sm">
                    Cerrar detalle
                </button>
            </div>

            <p id="descripcionDetalleDocumento"
               class="mb-4"></p>

               <section class="border rounded bg-light p-3 mb-4">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <h3 class="h6 mb-0">Procesamiento documental</h3>

                    <span id="estadoProcesamientoDetalleDocumento"></span>
                </div>

                <div class="row g-3">
                    <div class="col-md-3">
                        <div class="small text-muted">Páginas</div>
                        <div id="totalPaginasProcesamiento"
                             class="fw-semibold"></div>
                    </div>

                    <div class="col-md-3">
                        <div class="small text-muted">Caracteres extraídos</div>
                        <div id="totalCaracteresProcesamiento"
                             class="fw-semibold"></div>
                    </div>

                    <div class="col-md-3">
                        <div class="small text-muted">Chunks generados</div>
                        <div id="totalChunksProcesamiento"
                             class="fw-semibold"></div>
                    </div>

                    <div class="col-md-3">
                        <div class="small text-muted">Fechas</div>
                        <div id="fechasProcesamiento"
                             class="small"></div>
                    </div>

                    <div class="col-12">
                        <div class="small text-muted">Observaciones</div>
                        <div id="observacionesProcesamiento"
                             class="small"></div>
                    </div>
                </div>
            </section>

            @if (puedeAdministrar)
            {
                <section id="panelNuevaVersion" class="border rounded p-3 mb-4">
                    <h3 class="h6 mb-3">Nueva versión</h3>

                    <form id="formNuevaVersionDocumento"
                          class="row g-3">
                        <div class="col-md-9">
                            <input id="archivoNuevaVersion"
                                   class="form-control"
                                   type="file"
                                   accept=".pdf,application/pdf"
                                   required />
                        </div>

                        <div class="col-md-3">
                            <button id="btnGuardarNuevaVersion"
                                    type="submit"
                                    class="btn btn-outline-primary w-100">
                                Cargar versión
                            </button>
                        </div>
                    </form>
                </section>
            }

            <section class="mb-4">
                <h3 class="h5 mb-3">Versiones del documento</h3>

                <div class="table-responsive">
                    <table class="table table-sm align-middle">
                        <thead>
                            <tr>
                                <th>Versión</th>
                                <th>Archivo</th>
                                <th>Tamaño</th>
                                <th>Fecha</th>
                                <th>Usuario</th>
                                <th>Estado</th>
                                <th class="text-end">Acción</th>
                            </tr>
                        </thead>

                        <tbody id="versionesDocumentoBody"></tbody>
                    </table>
                </div>
            </section>

            <section id="panelChunksDocumento"
                     class="border rounded p-3 mb-4 d-none">
                <div class="d-flex justify-content-between align-items-start mb-3">
                    <div>
                        <h3 id="tituloChunksDocumento" class="h5 mb-1">
                            Chunks del documento
                        </h3>

                        <p id="metadatosChunksDocumento"
                           class="text-muted mb-0"></p>
                    </div>

                    <button id="btnCerrarChunksDocumento"
                            type="button"
                            class="btn btn-outline-secondary btn-sm">
                        Cerrar
                    </button>
                </div>

                <div id="contenedorChunksDocumento"
                     class="d-flex flex-column gap-3"></div>
            </section>

            @if (puedeAdministrar)
            {
                <section>
                    <h3 class="h5 mb-3">Auditoría del documento</h3>

                    <div class="table-responsive">
                        <table class="table table-sm align-middle mb-0">
                            <thead>
                                <tr>
                                    <th>Fecha</th>
                                    <th>Usuario</th>
                                    <th>Acción</th>
                                    <th>Descripción</th>
                                    <th>IP</th>
                                </tr>
                            </thead>

                            <tbody id="auditoriaDocumentoBody"></tbody>
                        </table>
                    </div>
                </section>
            }
        </div>
    </section>
</div>

@section Scripts {
    <script src="~/js/documentos.js"
            asp-append-version="true"></script>
}