@model Asistente.Web.Models.AdministracionViewModel

@{
    ViewData["Title"] = "Categorías documentales";
}

<div id="categoriasDocumentosPage"
     data-api-base-url="@Model.ApiBaseUrl">

    <div class="d-flex justify-content-between align-items-start mb-4">
        <div>
            <h1 class="h3 mb-1">Categorías documentales</h1>
            <p class="text-muted mb-0">
                Organiza los documentos por tipo, proceso o área responsable.
            </p>
        </div>
    </div>

    <div id="mensajeCategoriasDocumentos"
         class="alert d-none"
         role="alert"></div>

    <section class="card shadow-sm mb-4">
        <div class="card-body">
            <h2 id="tituloFormularioCategoria" class="h5 mb-3">
                Nueva categoría
            </h2>

            <form id="formCategoriaDocumento" class="row g-3">
                <input id="idCategoriaDocumento" type="hidden" />

                <div class="col-md-5">
                    <label for="nombreCategoriaDocumento"
                           class="form-label">
                        Nombre
                    </label>

                    <input id="nombreCategoriaDocumento"
                           class="form-control"
                           maxlength="100"
                           required />
                </div>

                <div class="col-md-7">
                    <label for="descripcionCategoriaDocumento"
                           class="form-label">
                        Descripción
                    </label>

                    <input id="descripcionCategoriaDocumento"
                           class="form-control"
                           maxlength="500" />
                </div>

                <div class="col-12 d-flex justify-content-end gap-2">
                    <button id="btnCancelarCategoria"
                            type="button"
                            class="btn btn-outline-secondary d-none">
                        Cancelar
                    </button>

                    <button id="btnGuardarCategoria"
                            type="submit"
                            class="btn btn-primary">
                        Crear categoría
                    </button>
                </div>
            </form>
        </div>
    </section>

    <section class="card shadow-sm">
        <div class="card-body">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <h2 class="h5 mb-0">Categorías registradas</h2>

                <button id="btnActualizarCategorias"
                        type="button"
                        class="btn btn-outline-primary btn-sm">
                    Actualizar
                </button>
            </div>

            <div class="table-responsive">
                <table class="table align-middle mb-0">
                    <thead>
                        <tr>
                            <th>Nombre</th>
                            <th>Descripción</th>
                            <th>Estado</th>
                            <th>Fecha de creación</th>
                            <th class="text-end">Acciones</th>
                        </tr>
                    </thead>

                    <tbody id="categoriasDocumentosBody"></tbody>
                </table>
            </div>
        </div>
    </section>
</div>

@section Scripts {
    <script src="~/js/categorias-documentos.js"
            asp-append-version="true"></script>
}