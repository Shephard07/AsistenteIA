@{
    Layout = null;
    ViewData["Title"] = "Acceso denegado";

    var controladorDestino =
        User.IsInRole("Supervisor") ? "Auditoria" :
        User.IsInRole("Administrador") || User.IsInRole("Operador")
            ? "Chat"
            : "Cuenta";

    var accionDestino =
        controladorDestino == "Cuenta"
            ? "IniciarSesion"
            : "Index";

    var textoDestino =
        controladorDestino == "Auditoria"
            ? "Ir a Auditoría"
            : controladorDestino == "Chat"
                ? "Ir al asistente"
                : "Iniciar sesión";
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - AsistenteIA</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
</head>
<body class="bg-light">
    <main class="container">
        <div class="row justify-content-center align-items-center min-vh-100">
            <div class="col-md-7 col-lg-5 text-center">
                <h1 class="h3">Acceso denegado</h1>
                <p class="text-muted">
                    No tienes permisos para acceder a esta opción.
                </p>
                <a asp-controller="@controladorDestino"
                   asp-action="@accionDestino"
                   class="btn btn-primary">
                    @textoDestino
                </a>
            </div>
        </div>
    </main>
</body>
</html>