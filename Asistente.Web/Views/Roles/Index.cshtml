@model Asistente.Web.Models.AdministracionViewModel

@{
    ViewData["Title"] = "Administración de roles";
}

<div data-api-base-url="@Model.ApiBaseUrl" id="rolesPage">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="h3 mb-1">Administración de roles</h1>
            <p class="text-muted mb-0">
                Crea, edita, activa o desactiva perfiles de acceso.
            </p>
        </div>
    </div>

    <div id="mensajeRoles" class="alert d-none" role="alert"></div>

    <section class="card shadow-sm mb-4">
        <div class="card-body">
            <h2 class="h5 mb-3">Nuevo rol</h2>

            <form id="formCrearRol" class="row g-3">
                <div class="col-md-4">
                    <label for="nombreRol" class="form-label">Nombre</label>
                    <input id="nombreRol"
                           class="form-control"
                           maxlength="50"
                           required />
                </div>

                <div class="col-md-6">
                    <label for="descripcionRol"
                           class="form-label">Descripción</label>
                    <input id="descripcionRol"
                           class="form-control"
                           maxlength="250"
                           required />
                </div>

                <div class="col-md-2 d-flex align-items-end">
                    <button class="btn btn-primary w-100" type="submit">
                        Crear
                    </button>
                </div>
            </form>
        </div>
    </section>

    <section class="card shadow-sm">
        <div class="card-body">
            <h2 class="h5 mb-3">Roles registrados</h2>

            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead>
                        <tr>
                            <th>ID</th>
                            <th>Nombre</th>
                            <th>Descripción</th>
                            <th>Estado</th>
                            <th class="text-end">Acciones</th>
                        </tr>
                    </thead>
                    <tbody id="rolesBody">
                        <tr>
                            <td colspan="5" class="text-center text-muted">
                                Cargando roles...
                            </td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>
    </section>
</div>

@section Scripts {
    <script src="~/js/roles.js" asp-append-version="true"></script>
}