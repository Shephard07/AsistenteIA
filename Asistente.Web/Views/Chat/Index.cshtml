@model Asistente.Web.Models.ChatViewModel

@{
    ViewData["Title"] = "Asistente Inteligente Empresarial";
}

<link rel="stylesheet" href="~/css/chat.css" />

<div class="chat-page" data-api-base-url="@Model.ApiBaseUrl">
    <aside class="conversation-sidebar">
        <div class="sidebar-header">
            <div>
                <p class="sidebar-eyebrow">CONVERSACIONES</p>
                <h2>Mi historial</h2>
            </div>

            <button id="newConversationButton"
                    type="button"
                    class="btn btn-primary btn-sm">
                + Nueva
            </button>
        </div>

        <label for="searchConversationInput" class="visually-hidden">
            Buscar conversación
        </label>

        <input id="searchConversationInput"
               type="search"
               class="form-control"
               placeholder="Buscar por título..." />

        <div class="form-check form-switch mt-3 mb-2">
            <input id="showArchivedInput"
                   class="form-check-input"
                   type="checkbox" />

            <label class="form-check-label small"
                   for="showArchivedInput">
                Mostrar archivadas
            </label>
        </div>

        <div id="conversationList"
             class="conversation-list"
             aria-live="polite">
            <p class="text-muted small p-3 mb-0">
                Cargando conversaciones...
            </p>
        </div>
    </aside>

    <section class="chat-card">
        <header class="chat-header">
            <div>
                <p class="chat-eyebrow">IA LOCAL · OLLAMA</p>
                <h1 id="conversationTitle">Nueva conversación</h1>
                <p id="conversationSubtitle" class="chat-subtitle">
                    Inicia una consulta para crear una conversación.
                </p>
            </div>

            <div class="chat-actions">
                <button id="renameButton"
                        type="button"
                        class="btn btn-outline-light btn-sm"
                        disabled>
                    Renombrar
                </button>

                <button id="archiveButton"
                        type="button"
                        class="btn btn-outline-light btn-sm"
                        disabled>
                    Archivar
                </button>

                <button id="deleteButton"
                        type="button"
                        class="btn btn-outline-light btn-sm"
                        disabled>
                    Eliminar
                </button>
            </div>
        </header>

        <main id="chatMessages" class="chat-messages" aria-live="polite">
            <article class="message message-assistant">
                <span class="message-role">Asistente</span>
                <p>
                    ¡Hola! Soy tu asistente inteligente empresarial.
                    ¿En qué puedo ayudarte hoy?
                </p>
            </article>
        </main>

        <div id="loadingIndicator" class="loading-indicator d-none">
            <span class="spinner-border spinner-border-sm" aria-hidden="true"></span>
            La IA está generando una respuesta...
        </div>

        <footer class="chat-composer">
            <label for="messageInput" class="visually-hidden">
                Escribe tu mensaje
            </label>

            <textarea id="messageInput"
                      class="form-control"
                      rows="2"
                      maxlength="2000"
                      placeholder="Escribe tu pregunta aquí..."></textarea>

            <button id="sendButton" type="button" class="btn btn-primary">
                Enviar
            </button>
        </footer>

        <p id="validationMessage" class="validation-message" role="alert"></p>
    </section>
</div>

@section Scripts {
    <script src="~/js/chat.js" asp-append-version="true"></script>
}