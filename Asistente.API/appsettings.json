{
  "ConnectionStrings": {
    "AsistenteIA": "Server=localhost\\SQLEXPRESS;Database=AsistenteIA;Trusted_Connection=True;TrustServerCertificate=True;MultipleActiveResultSets=True;"
  },
  "GestorDocumental": {
    "RutaArchivos": "C:\\AsistenteIAData\\Documentos",
    "TamanoMaximoBytes": 10485760,
    "ExtensionesPermitidas": [ ".pdf" ]
  },
  "Ollama": {
    "BaseUrl": "http://localhost:11434",
    "Model": "deepseek-r1:7b",
    "TimeoutSeconds": 120,
    "KeepAlive": "10m"
  },

  "ProcesamientoDocumental": {
    "TamanoMaximoChunk": 1200,
    "SolapamientoChunk": 150,
    "LongitudMinimaChunk": 200,
    "FrecuenciaSegundos": 15,
    "MaximoDocumentosPorCiclo": 2
  },

  "Cors": {
    "AllowedOrigins": [
      "https://localhost:7201",
      "http://localhost:5201"
    ]
  },
  "Serilog": {
    "Using": [
      "Serilog.Sinks.Console",
      "Serilog.Sinks.File"
    ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.EntityFrameworkCore.Database.Command": "Information"
      }
    },
    "WriteTo": [
      {
        "Name": "Console"
      },
      {
        "Name": "File",
        "Args": {
          "path": "Logs/log-.txt",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 14,
          "shared": true
        }
      }
    ],
    "Enrich": [
      "FromLogContext"
    ],
    "Properties": {
      "Application": "AsistenteIA.API"
    }
  },
  "AllowedHosts": "*"
}